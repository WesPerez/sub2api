        "label": "Sub2API 请求超时",
        "type": "integer",
        "default": 20,
        "min": 5,
        "max": 20,
        "unit": "秒",
        "section": "常用参数",
        "help": ""
      },
      {
        "key": "operating.resin_timeout_seconds",
        "label": "Resin 请求超时",
        "type": "integer",
        "default": 10,
        "min": 5,
        "max": 10,
        "unit": "秒",
        "section": "常用参数",
        "help": ""
      }
    ],
    "effect": "下一次对齐时生效；账号平台与代理身份映射继续由原配置维护。"
  }
}
