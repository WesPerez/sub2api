[Unit]
Description=Scheduled Sub2API AgentRouter account recovery
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sub2api-operations
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/server-scheduled-tasks/sub2api-recovery.env
ExecStart=/usr/bin/python3 -u /opt/sub2api-operations/operations/tasks/sub2api-recovery/worker.py --once
TimeoutStartSec=25min
TimeoutStopSec=10min
UMask=0077
RuntimeDirectory=server-scheduled-tasks
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/server-scheduled-tasks
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
