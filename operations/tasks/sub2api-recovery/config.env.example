SUB2API_RECOVERY_BASE_URL=http://127.0.0.1:13080
SUB2API_RECOVERY_ADMIN_KEY_FILE=/etc/server-scheduled-tasks/sub2api-admin-key

# AgentRouter 恢复分支：上海时间每小时整点分页拉取全部未软删除账号，
# 凭据 base_url 的 HTTPS 主机名须严格等于 agentrouter.org；先按规则分类，再恢复和关闭调度，
# GPT / Claude / GLM / DeepSeek 四类默认各开放备注余额最高的 3 个；不发探针。
# 类型后缀和数量在 agentrouter-recovery.json 配置；执行时间由 systemd timer 管理。
SUB2API_RECOVERY_AGENTROUTER_ENABLED=true
SUB2API_RECOVERY_AGENTROUTER_STATE_FILE=/var/lib/server-scheduled-tasks/sub2api-agentrouter-recovery-state.json

SUB2API_RECOVERY_REQUEST_TIMEOUT=150
